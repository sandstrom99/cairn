{
  "name": "cairn",
  "version": "0.1.0",
  "description": "An agent worklist on Convex. The cn skill, the session-start situation report, the one line a session is handed when it stops holding an unjournaled claim, the slash commands, and the evals that hold the skill's rules in a real session.",
  "author": {
    "name": "Balder Sandstrom",
    "url": "https://github.com/sandstrom99"
  },
  "repository": "https://github.com/sandstrom99/cairn",
  "keywords": ["issue-tracker", "task-management", "agent-memory", "convex"],
  "skills": "./skills/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
