{
  // The type-check of cn. Nothing is built from it: Node 24 strips the types itself, so
  // this exists to be told when a call does not match a signature.
  //
  // erasableSyntaxOnly is what makes that viable. Node strips types without understanding
  // them, so anything that needs code generated — an enum, a namespace, a parameter
  // property — is refused here rather than left to fail at runtime.
  //
  // Resolution is "bundler", not "nodenext", because this program follows the generated
  // `api` into @cairn/backend's sources, which import without extensions the way Convex
  // does. Under nodenext those imports fail to resolve and every `api.*` call silently
  // types as `any`. The cost is that nothing here insists on the extension Node needs at
  // runtime; src/smoke.test.mts runs the real cn under Node and is what catches that.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true
  },
  "include": ["src/**/*.mts", "vite.config.ts"]
}
